# FPDesigner — local development environment
# Copy to .env.local for Next.js. Never commit real secrets.

APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# Supabase Auth (client-safe)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Factory customer-gateway (server-only)
FACTORY_CUSTOMER_GATEWAY_URL=http://127.0.0.1:3001
